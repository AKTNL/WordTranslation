{
  "manifest_version": 3,
  "name": "PaperDict - 论文划词翻译助手",
  "version": "2.3.0",
  "description": "专为英文论文与学术文献设计的划词即翻悬浮查词工具，内置 15,000+ 学术核心词汇、智能连字符断词修复与在线整句翻译。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PaperDict 论文划词翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "bilingual.css"
      ],
      "js": [
        "dict/academic_dict.js",
        "dict_service.js",
        "annotation_manager.js",
        "glossary_extractor.js",
        "citation_parser.js",
        "content.js",
        "bilingual.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "dict/*",
        "reader/*",
        "bilingual.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
